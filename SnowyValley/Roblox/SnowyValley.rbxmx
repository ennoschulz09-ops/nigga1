idth_m":40,"drop_m":5.81},{"id":2,"name":"High Ridge Run","legend":"blue","character":"blue","start_m":123.0,"end_m":358.0,"width_m":32,"drop_m":35.23},{"id":3,"name":"Cliff Descent","legend":"red","character":"red","start_m":358.0,"end_m":561.0,"width_m":24,"drop_m":55.04},{"id":4,"name":"Forest Run","legend":"green","character":"blue","start_m":561.0,"end_m":1205.0,"width_m":28,"drop_m":84.32},{"id":5,"name":"Wide Carve","legend":"blue","character":"blue","start_m":1205.0,"end_m":1609.0,"width_m":52,"drop_m":63.66},{"id":6,"name":"Rocky Pass","legend":"red","character":"red","start_m":1609.0,"end_m":1874.0,"width_m":26,"drop_m":37.94},{"id":7,"name":"Tree Section","legend":"green","character":"blue","start_m":1874.0,"end_m":2481.0,"width_m":30,"drop_m":82.45},{"id":8,"name":"Bridge Section","legend":"orange","character":"blue","start_m":2481.0,"end_m":2786.0,"width_m":22,"drop_m":25.11},{"id":9,"name":"Frozen Lake","legend":"blue","character":"blue","start_m":2786.0,"end_m":3003.0,"width_m":34,"drop_m":21.67},{"id":10,"name":"Mountain Pass","legend":"red","character":"red","start_m":3003.0,"end_m":3165.0,"width_m":30,"drop_m":30.31},{"id":11,"name":"Canyon Run","legend":"blue","character":"blue","start_m":3165.0,"end_m":3654.0,"width_m":24,"drop_m":73.23},{"id":12,"name":"Ice Cave","legend":"blue","character":"blue","start_m":3654.0,"end_m":3821.0,"width_m":22,"drop_m":21.94},{"id":13,"name":"S-Curve","legend":"purple","character":"blue","start_m":3821.0,"end_m":4062.0,"width_m":40,"drop_m":40.59},{"id":14,"name":"Steep Slopes","legend":"red","character":"red","start_m":4062.0,"end_m":4280.0,"width_m":36,"drop_m":65.88},{"id":15,"name":"Open Fields","legend":"green","character":"green","start_m":4280.0,"end_m":4485.0,"width_m":58,"drop_m":23.74},{"id":16,"name":"Final Slopes","legend":"green","character":"blue","start_m":4485.0,"end_m":4692.0,"width_m":40,"drop_m":41.14},{"id":17,"name":"Village Approach","legend":"blue","character":"blue","start_m":4692.0,"end_m":4794.0,"width_m":32,"drop_m":11.25},{"id":18,"name":"Finish (Valley Plaza)","legend":"finish","character":"finish","start_m":4794.0,"end_m":4828.0,"width_m":60,"drop_m":0.7}],"main":{"race_length_m":4828.0,"drop_m":720.0}}]=])
