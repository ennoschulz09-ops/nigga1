				<Item class="ModuleScript" referent="RBXSV00011">
					<Properties>
						<string name="Name">EnvironmentPreset</string>
						<ProtectedString name="Source"><![CDATA[--!strict
-- Snowy Valley - environment preset (late-afternoon alpine light).
--
-- The game's WorldEnvironmentController owns Lighting. Pass `Preset` to it
-- from Integration.ApplyEnvironment. ApplyDirect() exists only for the
-- standalone test mode / places without a controller: it writes Lighting and
-- its own SV_* effect instances and returns a function that restores every
-- value it changed.

local Lighting = game:GetService("Lighting")

local Data = require(script.Parent:WaitForChild("Data"):WaitForChild("Environment")) :: any

local EnvironmentPreset = {}

local function rgb(t: { number }): Color3
	return Color3.fromRGB(t[1], t[2], t[3])
end

-- Plain, controller-friendly description (Roblox value types).
EnvironmentPreset.Preset = {
	Name = Data.name,
	Lighting = {
		ClockTime = Data.lighting.ClockTime,
		GeographicLatitude = Data.lighting.GeographicLatitude,
		Brightness = Data.lighting.Brightness,
		ExposureCompensation = Data.lighting.ExposureCompensation,
		EnvironmentDiffuseScale = Data.lighting.EnvironmentDiffuseScale,
		EnvironmentSpecularScale = Data.lighting.EnvironmentSpecularScale,
		Ambient = rgb(Data.lighting.Ambient),
		OutdoorAmbient = rgb(Data.lighting.OutdoorAmbient),
		ColorShift_Top = rgb(Data.lighting.ColorShift_Top),
		ColorShift_Bottom = rgb(Data.lighting.ColorShift_Bottom),
		ShadowSoftness = Data.lighting.ShadowSoftness,
		GlobalShadows = Data.lighting.GlobalShadows,
		FogColor = rgb(Data.lighting.FogColor),
		FogStart = Data.lighting.FogStart,
		FogEnd = Data.lighting.FogEnd,
	},
	Atmosphere = {
		Density = Data.atmosphere.Density,
		Offset = Data.atmosphere.Offset,
		Color = rgb(Data.atmosphere.Color),
		Decay = rgb(Data.atmosphere.Decay),
		Glare = Data.atmosphere.Glare,
		Haze = Data.atmosphere.Haze,
	},
	Sky = {
		SunAngularSize = Data.sky.SunAngularSize,
		MoonAngularSize = Data.sky.MoonAngularSize,
		StarCount = Data.sky.StarCount,
		CelestialBodiesShown = Data.sky.CelestialBodiesShown,
	},
	Clouds = {
		Cover = Data.clouds.Cover,
		Density = Data.clouds.Density,
		Color = rgb(Data.clouds.Color),
	},
	Bloom = { Intensity = Data.bloom.Intensity, Size = Data.bloom.Size, Threshold = Data.bloom.Threshold },
	ColorCorrection = {
		Brightness = Data.color_correction.Brightness,
		Contrast = Data.color_correction.Contrast,
		Saturation = Data.color_correction.Saturation,
		TintColor = rgb(Data.color_correction.TintColor),
	},
	SunRays = { Intensity = Data.sun_rays.Intensity, Spread = Data.sun_rays.Spread },
}

local function ensure(className: string, name: string, parent: Instance): (Instance, boolean)
	local existing = parent:FindFirstChild(name)
	if existing and existing.ClassName == className then
		return existing, false
	end
	local inst = Instance.new(className)
	inst.Name = name
	inst.Parent = parent
	return inst, true
end

-- Apply the preset straight to Lighting. Returns restore().
function EnvironmentPreset.ApplyDirect(): () -> ()
	local P = EnvironmentPreset.Preset
	local saved: { [string]: any } = {}
	local L = Lighting :: any
	for prop: string, value in P.Lighting :: { [string]: any } do
		saved[prop] = L[prop]
		L[prop] = value
	end
	local created: { Instance } = {}
	local function effect(className: string, name: string, props: { [string]: any }, parent: Instance)
		local inst, isNew = ensure(className, name, parent)
		if isNew then
			table.insert(created, inst)
		end
		local target = inst :: any
		for k, v in props do
			target[k] = v
		end
	end
	-- an Atmosphere / Sky of the game is left untouched if it already exists
	if not Lighting:FindFirstChildOfClass("Atmosphere") then
		effect("Atmosphere", "SV_Atmosphere", P.Atmosphere, Lighting)
	end
	if not Lighting:FindFirstChildOfClass("Sky") then
		effect("Sky", "SV_Sky", P.Sky, Lighting)
	end
	effect("BloomEffect", "SV_Bloom", P.Bloom, Lighting)
	effect("ColorCorrectionEffect", "SV_ColorCorrection", P.ColorCorrection, Lighting)
	effect("SunRaysEffect", "SV_SunRays", P.SunRays, Lighting)
	if not workspace.Terrain:FindFirstChildOfClass("Clouds") then
		effect("Clouds", "SV_Clouds", P.Clouds, workspace.Terrain)
	end
	return function()
		for prop, value in saved do
			L[prop] = value
		end
		for _, inst in created do
			inst:Destroy()
		end
	end
end

return EnvironmentPreset
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBXSV00012">
					<Properties>
						<string name="Name">GondolaClient</string>
						<ProtectedString name="Source"><![CDATA[--!strict
-- Snowy Valley - client-side gondola animation.
--
-- The server builds the cables only; every client animates its own cabins
-- along the closed loop paths from GondolaData at constant speed (no
-- network traffic, no physics). Cabins are animated only while the Snowy
-- Valley world is loaded and the local camera is near a line.
-- Passenger transport is NOT implemented (cabins are scenery).

local RunService = game:GetService("RunService")

local Shared = script.Parent
local Config = require(Shared:WaitForChild("Config"))

local GondolaClient = {}

type Line = {
	id: string,
	n: number,
	px: { number },
	py: { number },
	pz: { number },
	cum: { number },
	length: number,
	speed: number,
	cabins: { { model: Model, offset: number, parts: { BasePart }, rel: { CFrame } } },
	minX: number,
	maxX: number,
	minZ: number,
	maxZ: number,
}

local lines: { Line } = {}
local folder: Folder? = nil
local clock = 0
local active = false

local function buildLine(def: any): Line
	local pts: { number } = def.path
	local n = #pts // 3
	local line: Line = {
		id = def.id,
		n = n,
		px = table.create(n),
		py = table.create(n),
		pz = table.create(n),
		cum = table.create(n + 1),
		length = 0,
		speed = def.speed_studs,
		cabins = {},
		minX = math.huge,
		maxX = -math.huge,
		minZ = math.huge,
		maxZ = -math.huge,
	}
	for i = 1, n do
		line.px[i], line.py[i], line.pz[i] = pts[(i - 1) * 3 + 1], pts[(i - 1) * 3 + 2], pts[(i - 1) * 3 + 3]
		line.minX = math.min(line.minX, line.px[i])
		line.maxX = math.max(line.maxX, line.px[i])
		line.minZ = math.min(line.minZ, line.pz[i])
		line.maxZ = math.max(line.maxZ, line.pz[i])
	end
	line.cum[1] = 0
	for i = 1, n do
		local j = i % n + 1
		local dx, dy, dz = line.px[j] - line.px[i], line.py[j] - line.py[i], line.pz[j] - line.pz[i]
		line.cum[i + 1] = line.cum[i] + math.sqrt(dx * dx + dy * dy + dz * dz)
	end
	line.length = line.cum[n + 1]
	return line
end

-- Position + horizontal direction at loop distance d.
local function sample(line: Line, d: number): (Vector3, Vector3)
	d = d % line.length
	local lo, hi = 1, line.n + 1
	while hi - lo > 1 do
		local mid = (lo + hi) // 2
		if line.cum[mid] <= d then
			lo = mid
		else
			hi = mid
		end
	end
	local i = lo
	local j = i % line.n + 1
	local seg = line.cum[i + 1] - line.cum[i]
	local t = if seg > 1e-6 then (d - line.cum[i]) / seg else 0
	local p = Vector3.new(
		line.px[i] + (line.px[j] - line.px[i]) * t,
		line.py[i] + (line.py[j] - line.py[i]) * t,
		line.pz[i] + (line.pz[j] - line.pz[i]) * t
	)
	local dir = Vector3.new(line.px[j] - line.px[i], 0, line.pz[j] - line.pz[i])
	if dir.Magnitude < 1e-6 then
		dir = Vector3.new(0, 0, -1)
	end
	return p, dir.Unit
end

local function spawnCabins(template: Model, def: any, line: Line, budget: number): number
	local count = math.min(math.floor(line.length / def.spacing_studs), budget)
	for k = 0, count - 1 do
		local m = template:Clone()
		local pivot = m:GetPivot()
		local parts, rel = {}, {}
		for _, d in m:GetDescendants() do
			if d:IsA("BasePart") then
				d.Anchored = true
				d.CanCollide = false
				d.CanQuery = false
				d.CanTouch = false
				table.insert(parts, d)
				table.insert(rel, pivot:ToObjectSpace(d.CFrame))
			end
		end
		m.Parent = folder
		table.insert(line.cabins, { model = m, offset = k * line.length / count, parts = parts, rel = rel })
	end
	return count
end

local function nearAnyLine(pos: Vector3): boolean
	local r = Config.Gondola.ActivationDistance
	for _, line in lines do
		if pos.X > line.minX - r and pos.X < line.maxX + r and pos.Z > line.minZ - r and pos.Z < line.maxZ + r then
			return true
		end
	end
	return false
end

local function step(dt: number)
	clock += dt
	local parts: { BasePart } = {}
	local cfs: { CFrame } = {}
	for _, line in lines do
		for _, cab in line.cabins do
			local p, dir = sample(line, cab.offset + clock * line.speed)
			local cf = CFrame.lookAt(p, p + dir)
			for i, part in cab.parts do
				table.insert(parts, part)
				table.insert(cfs, cf * cab.rel[i])
			end
		end
	end
	workspace:BulkMoveTo(parts, cfs, Enum.BulkMoveMode.FireCFrameChanged)
end

local function setActive(on: boolean)
	if on == active then
		return
	end
	active = on
	if folder then
		folder.Parent = if on then workspace else nil
	end
end

function GondolaClient.Start()
	local data = require(Shared:WaitForChild("Data"):WaitForChild("GondolaData")) :: any
	local assets = Shared:WaitForChild("Assets", 30)
	local template = assets and assets:WaitForChild("GondolaCabin", 30)
	if not template or not template:IsA("Model") then
		warn("[SnowyValley] GondolaCabin template missing - run Importer.Build() (cabins disabled)")
		return
	end
	local f = Instance.new("Folder")
	f.Name = "SnowyValley_GondolaCabins"
	folder = f
	local budget = Config.Gondola.MaxCabins
	for _, def in data.lines do
		local line = buildLine(def)
		budget -= spawnCabins(template, def, line, budget)
		table.insert(lines, line)
	end
	-- activate only while the world is loaded and the camera is near a line
	task.spawn(function()
		while true do
			local cam = workspace.CurrentCamera
			local loaded = workspace:FindFirstChild(Config.WorldId) ~= nil
			setActive(loaded and cam ~= nil and nearAnyLine(cam.CFrame.Position))
			task.wait(1)
		end
	end)
	RunService.Heartbeat:Connect(function(dt)
		if active then
			step(dt)
		end
	end)
end

return GondolaClient
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBXSV00013">
					<Properties>
						<string name="Name">RouteGraph</string>
						<ProtectedString name="Source"><![CDATA[--!strict
-- Snowy Valley - route graph built from RouteData.
--
-- Answers, for any position: which route corridor it is on, the station and
-- race progress there, the signed lateral offset and how far outside the
-- rideable corridor (piste + margins) it is. Used for out-of-bounds
-- detection, respawn frames and the progress-based checkpoint fallback.
--
-- Pure Luau on plain numbers (no Roblox types), so the same module runs in
-- Studio and in the standalone `luau` test runner.

local RouteGraph = {}
RouteGraph.__index = RouteGraph

local CELL = 96 -- studs, spatial hash cell size (XZ plane)
local SURF_TUNNEL = 2

type Route = {
	id: string,
	name: string,
	kind: string,
	difficulty: string,
	index: number,
	n: number,
	x: { number },
	y: { number },
	z: { number },
	s: { number }, -- studs along this route
	progress: { number }, -- studs of main-route progress
	halfWidth: { number },
	marginL: { number },
	marginR: { number },
	surface: { number },
	section: { number },
	length: number,
}

export type Hit = {
	route: string,
	routeIndex: number,
	segment: number,
	t: number,
	s: number, -- studs along the hit route
	progress: number, -- studs of main-route progress
	lateral: number, -- signed horizontal offset, + = right of travel
	distance: number, -- horizontal distance to the centreline
	halfWidth: number,
	margin: number, -- margin on the side of the position
	edgeDistance: number, -- > 0: studs outside the rideable corridor
	x: number, -- centreline point
	y: number,
	z: number,
	tx: number, -- horizontal unit travel direction
	tz: number,
	surface: number, -- 0 ground, 1 bridge, 2 tunnel
	section: number,
}

export type Status = "ok" | "outside" | "below" | "roof" | "far"

export type Options = {
	lateralLimit: number?, -- studs outside the corridor before "outside"
	belowLimit: number?, -- studs below the centreline before "below"
	roofLimit: number?, -- studs above a tunnel floor before "roof"
}

export type RouteGraph = typeof(setmetatable(
	{} :: {
		routes: { Route },
		byId: { [string]: Route },
		cellRoute: { [number]: { number } },
		cellSeg: { [number]: { number } },
		studsPerMeter: number,
		raceLength: number,
		lateralLimit: number,
		belowLimit: number,
		roofLimit: number,
	},
	RouteGraph
))

local function cellKey(cx: number, cz: number): number
	return (cx + 32768) * 65536 + (cz + 32768)
end

local function lerp(a: number, b: number, t: number): number
	return a + (b - a) * t
end

function RouteGraph.new(data: any, options: Options?): RouteGraph
	local opts: Options = options or {}
	local K: number = data.units.studs_per_meter
	local self = setmetatable({
		routes = {} :: { Route },
		byId = {} :: { [string]: Route },
		cellRoute = {} :: { [number]: { number } },
		cellSeg = {} :: { [number]: { number } },
		studsPerMeter = K,
		raceLength = (data.main.race_length_m :: number) * K,
		lateralLimit = opts.lateralLimit or 30,
		belowLimit = opts.belowLimit or 60,
		roofLimit = opts.roofLimit or 55,
	}, RouteGraph)

	for ri, def in data.routes do
		local samples = def.samples
		local n = #samples
		local route: Route = {
			id = def.id,
			name = def.name,
			kind = def.kind,
			difficulty = def.difficulty,
			index = ri,
			n = n,
			x = table.create(n),
			y = table.create(n),
			z = table.create(n),
			s = table.create(n),
			progress = table.create(n),
			halfWidth = table.create(n),
			marginL = table.create(n),
			marginR = table.create(n),
			surface = table.create(n),
			section = table.create(n),
			length = (def.length_m :: number) * K,
		}
		for i, smp in samples do
			route.x[i] = smp[1]
			route.y[i] = smp[2]
			route.z[i] = smp[3]
			route.s[i] = smp[4] * K
			route.progress[i] = smp[5] * K
			route.halfWidth[i] = smp[6]
			route.marginL[i] = smp[7]
			route.marginR[i] = smp[8]
			route.surface[i] = smp[9]
			route.section[i] = smp[10]
		end
		self.routes[ri] = route
		self.byId[route.id] = route
		-- register every segment in all cells its corridor (+ lateral limit) touches
		for i = 1, n - 1 do
			local reach = math.max(
				route.halfWidth[i] + math.max(route.marginL[i], route.marginR[i]),
				route.halfWidth[i + 1] + math.max(route.marginL[i + 1], route.marginR[i + 1])
			) + self.lateralLimit + 8
			local x0 = math.floor((math.min(route.x[i], route.x[i + 1]) - reach) / CELL)
			local x1 = math.floor((math.max(route.x[i], route.x[i + 1]) + reach) / CELL)
			local z0 = math.floor((math.min(route.z[i], route.z[i + 1]) - reach) / CELL)
			local z1 = math.floor((math.max(route.z[i], route.z[i + 1]) + reach) / CELL)
			for cx = x0, x1 do
				for cz = z0, z1 do
					local key = cellKey(cx, cz)
					local lr = self.cellRoute[key]
					if not lr then
						lr = {}
						self.cellRoute[key] = lr
						self.cellSeg[key] = {}
					end
					table.insert(lr, ri)
					table.insert(self.cellSeg[key], i)
				end
			end
		end
	end
	return self
end

-- Closest corridor to (px, py, pz). Positions inside a corridor (horizontally)
-- and within 20 studs vertically all score 0 penalty; ties prefer the given
-- route (hysteresis at junctions), then the smaller horizontal distance.
function RouteGraph.Nearest(self: RouteGraph, px: number, py: number, pz: number, prefer: string?): Hit?
	local key = cellKey(math.floor(px / CELL), math.floor(pz / CELL))
	local lr = self.cellRoute[key]
	if not lr then
		return nil
	end
	local ls = self.cellSeg[key]
	local best: Hit? = nil
	local bestScore = math.huge
	for k = 1, #lr do
		local route = self.routes[lr[k]]
		local i = ls[k]
		local ax, az = route.x[i], route.z[i]
		local ex, ez = route.x[i + 1] - ax, route.z[i + 1] - az
		local len2 = ex * ex + ez * ez
		if len2 < 1e-9 then
			continue
		end
		local t = ((px - ax) * ex + (pz - az) * ez) / len2
		if t < 0 then
			t = 0
		elseif t > 1 then
			t = 1
		end
		local cx, cz = ax + ex * t, az + ez * t
		local len = math.sqrt(len2)
		local tx, tz = ex / len, ez / len
		local dx, dz = px - cx, pz - cz
		local lateral = dx * -tz + dz * tx -- right = (-tz, tx)
		local dist = math.sqrt(dx * dx + dz * dz)
		local hw = lerp(route.halfWidth[i], route.halfWidth[i + 1], t)
		local margin = if lateral >= 0
			then lerp(route.marginR[i], route.marginR[i + 1], t)
			else lerp(route.marginL[i], route.marginL[i + 1], t)
		local edge = dist - (hw + margin)
		local cy = lerp(route.y[i], route.y[i + 1], t)
		local dy = math.abs(py - cy)
		local score = math.max(edge, 0) + 0.35 * math.max(dy - 20, 0) + 0.001 * dist
		if prefer and route.id == prefer then
			score -= 2
		end
		if score < bestScore then
			bestScore = score
			local surf = if t < 0.5 then route.surface[i] else route.surface[i + 1]
			local sec = if t < 0.5 then route.section[i] else route.section[i + 1]
			best = {
				route = route.id,
				routeIndex = route.index,
				segment = i,
				t = t,
				s = lerp(route.s[i], route.s[i + 1], t),
				progress = lerp(route.progress[i], route.progress[i + 1], t),
				lateral = lateral,
				distance = dist,
				halfWidth = hw,
				margin = margin,
				edgeDistance = edge,
				x = cx,
				y = cy,
				z = cz,
				tx = tx,
				tz = tz,
				surface = surf,
				section = sec,
			}
		end
	end
	return best
end

-- Classify a position for out-of-bounds handling.
function RouteGraph.Classify(self: RouteGraph, px: number, py: number, pz: number, prefer: string?): (Status, Hit?)
	local hit = self:Nearest(px, py, pz, prefer)
	if not hit then
		return "far", nil
	end
	if hit.edgeDistance > self.lateralLimit then
		return "outside", hit
	end
	if py < hit.y - self.belowLimit then
		return "below", hit
	end
	if hit.surface == SURF_TUNNEL and py > hit.y + self.roofLimit and hit.edgeDistance < 0 then
		return "roof", hit
	end
	return "ok", hit
end

local function locate(route: Route, s: number): (number, number)
	-- binary search: segment i with route.s[i] <= s <= route.s[i + 1]
	local lo, hi = 1, route.n
	if s <= route.s[1] then
		return 1, 0
	end
	if s >= route.s[hi] then
		return hi - 1, 1
	end
	while hi - lo > 1 do
		local mid = (lo + hi) // 2
		if route.s[mid] <= s then
			lo = mid
		else
			hi = mid
		end
	end
	local span = route.s[lo + 1] - route.s[lo]
	return lo, if span > 1e-9 then (s - route.s[lo]) / span else 0
end

-- Centreline point and horizontal travel direction at station s (studs).
function RouteGraph.FrameAt(self: RouteGraph, routeId: string, s: number): (number, number, number, number, number)
	local route = self.byId[routeId]
	assert(route, "unknown route " .. tostring(routeId))
	local i, t = locate(route, s)
	local ex, ez = route.x[i + 1] - route.x[i], route.z[i + 1] - route.z[i]
	local len = math.sqrt(ex * ex + ez * ez)
	if len < 1e-9 then
		ex, ez, len = 0, -1, 1
	end
	return lerp(route.x[i], route.x[i + 1], t),
		lerp(route.y[i], route.y[i + 1], t),
		lerp(route.z[i], route.z[i + 1], t),
		ex / len,
		ez / len
end

-- Main-route progress (studs) at station s of a route.
function RouteGraph.ProgressAt(self: RouteGraph, routeId: string, s: number): number
	local route = self.byId[routeId]
	assert(route, "unknown route " .. tostring(routeId))
	local i, t = locate(route, s)
	return lerp(route.progress[i], route.progress[i + 1], t)
end

-- Respawn frame: `back` studs behind station s on the centreline, `up` studs
-- above it, facing downhill. Returns position + horizontal look direction.
function RouteGraph.RespawnFrame(
	self: RouteGraph,
	routeId: string,
	s: number,
	back: number,
	up: number
): (number, number, number, number, number)
	local x, y, z, tx, tz = self:FrameAt(routeId, math.max(s - back, 0))
	return x, y + up, z, tx, tz
end

function RouteGraph.GetRoute(self: RouteGraph, routeId: string): Route?
	return self.byId[routeId]
end

function RouteGraph.RouteIds(self: RouteGraph): { string }
	local ids = {}
	for _, r in self.routes do
		table.insert(ids, r.id)
	end
	return ids
end

return RouteGraph
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBXSV00014">
					<Properties>
						<string name="Name">Types</string>
						<ProtectedString name="Source"><![CDATA[--!strict
-- Snowy Valley - types of the generated metadata (see Metadata/*.json).
-- Positions are Roblox studs (X, Y up, Z); rotations are quaternions {x, y, z, w}.

export type Vec = { number } -- {x, y, z}
export type Quat = { number } -- {x, y, z, w}

-- RouteData ---------------------------------------------------------------
-- sample = {x, y, z, s_m, progress_m, halfwidth, margin_l, margin_r, surface, section}
-- (x, y, z, halfwidth and margins in studs; s and progress in meters)
export type RouteDef = {
	id: string,
	name: string,
	difficulty: string,
	kind: string, -- "main" | "alt"
	length_m: number,
	race_length_m: number?,
	branch_main_m: number?,
	merge_main_m: number?,
	samples: { { number } },
}

export type SectionDef = {
	id: number,
	name: string,
	legend: string,
	character: string,
	start_m: number,
	end_m: number,
	width_m: number,
	drop_m: number,
}

export type RouteData = {
	units: { studs_per_meter: number },
	routes: { RouteDef },
	sections: { SectionDef },
	main: { race_length_m: number, drop_m: number },
}

-- Checkpoints -------------------------------------------------------------
export type GateDef = {
	id: string,
	group: number,
	route: string,
	station_m: number,
	progress_m: number,
	progress_studs: number,
	position: Vec,
	rotation: Quat,
	size: Vec,
	is_finish: boolean,
	is_start: boolean,
	section: string,
}

export type GroupDef = { group: number, name: string, gates: { GateDef } }
export type SpawnDef = { position: Vec, rotation: Quat }
export type BoostDef = {
	id: string,
	station_m: number,
	position: Vec,
	rotation: Quat,
	size: Vec,
	direction: Vec,
	strength: number,
}

export type CheckpointData = {
	groups: { GroupDef },
	spawns: { SpawnDef },
	boosts: { BoostDef },
	group_count: number,
	finish_group: number,
	rule: string,
}

-- Collision ---------------------------------------------------------------
export type StripDef = {
	route: string,
	surface: number,
	kinds: { string },
	rows: { { number } }, -- each row: x1, y1, z1, x2, y2, z2, ... left -> right
}

export type BoxDef = { kind: string, position: Vec, rotation: Quat, size: Vec }
export type PatchDef = { name: string, nx: number, ny: number, points: { number }, mask: { number } }
export type KickerDef = { position: Vec, rotation: Quat, size: Vec }

export type CollisionData = {
	units: { studs_per_meter: number },
	strips: { StripDef },
	boxes: { BoxDef },
	patches: { PatchDef },
	kickers: { KickerDef },
}

-- Asset manifest ----------------------------------------------------------
export type RobloxLook = {
	Material: string,
	Color: { number },
	Reflectance: number?,
	Transparency: number?,
	Texture: string?,
}

export type TemplatePart = {
	mesh: string,
	material: string,
	roblox: RobloxLook,
	offset: Vec,
	size: Vec,
	tris: number,
}

export type TemplateDef = { category: string, file: string, parts: { TemplatePart }, tris: number }

export type UniqueDef = {
	mesh: string,
	category: string,
	file: string,
	material: string,
	roblox: RobloxLook,
	position: Vec,
	size: Vec,
	tris: number,
	collide: string,
	group: string,
}

export type LightDef = {
	kind: string,
	position: Vec,
	color: { number },
	range: number,
	brightness: number,
	shadows: boolean,
}

export type TextDef = {
	kind: string,
	position: Vec,
	rotation: Quat,
	size: { number },
	lines: { string },
	badge: { number },
}

-- instance = {assetIndex(0-based), px, py, pz, qx, qy, qz, qw, scale, collide, group}
export type AssetManifest = {
	version: string,
	units: { studs_per_meter: number },
	assets: { string },
	templates: { [string]: TemplateDef },
	instances: { { any } },
	unique: { UniqueDef },
	lights: { LightDef },
	texts: { TextDef },
	counts: { [string]: number },
}

-- Gondola -----------------------------------------------------------------
export type GondolaLine = {
	id: string,
	name: string,
	speed_studs: number,
	spacing_studs: number,
	cabin_template: string,
	hang_studs: number,
	gauge_studs: number,
	loop_length_studs: number,
	path: { number }, -- x, y, z, x, y, z, ... (closed loop)
	stations: { { asset: string, position: Vec, cable_y: number } },
	pylons: { { asset: string, position: Vec, cable_y: number } },
	passenger_transport: boolean,
	note: string,
}

export type GondolaData = { lines: { GondolaLine } }

return {}
]]></ProtectedString>
					</Properties>
				</Item>
			</Item>
		</Item>
		<Item class="Folder" referent="RBXSV00015">
			<Properties>
				<string name="Name">ServerStorage</string>
			</Properties>
			<Item class="Folder" referent="RBXSV00016">
				<Properties>
					<string name="Name">SnowyValleyServer</string>
				</Properties>
				<Item class="ModuleScript" referent="RBXSV00017">
					<Properties>
						<string name="Name">CollisionBuilder</string>
						<ProtectedString name="Source"><![CDATA[--!strict
-- Snowy Valley - builds the invisible collision world from CollisionData.
--
--   strips  : route riding surfaces. Each quad between two rows is split into
--             the triangles (A[c], B[c], B[c+1]) and (A[c], B[c+1], A[c+1]);
--             every triangle becomes two WedgeParts (right-triangle split).
--             The wedges are slabs extruded DOWN from the triangle, so their
--             top faces are exactly the riding surface.
--   patches : start platform, finish plaza and village ground (masked grids).
--   boxes   : boundary walls, bridge parapets, ice-cave walls / ceiling and
--             out-of-bounds catch floors.
--   kickers : WedgeParts matching the visual kicker ramps.
--
-- The visual meshes never collide; this geometry is what SlopeRaycaster and
-- the character physics touch. Every part carries SV_ attributes.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("SnowyValleyShared")
local Config = require(Shared:WaitForChild("Config"))

local CollisionBuilder = {}

local PREFIX = Config.AttributePrefix

type BuildStats = { wedges: number, boxes: number, kickers: number, models: number }

local function newWedge(): WedgePart
	local w = Instance.new("WedgePart")
	w.Anchored = true
	w.CanCollide = true
	w.CanTouch = false
	w.CanQuery = true
	w.CastShadow = false
	w.Locked = true
	w.Material = Enum.Material.Snow
	w.Transparency = if Config.Collision.Debug then 0.6 else 1
	w.Color = Color3.fromRGB(255, 140, 40)
	w.TopSurface = Enum.SurfaceType.Smooth
	w.BottomSurface = Enum.SurfaceType.Smooth
	return w
end

-- Two wedges for triangle (a, b, c), slab of `thickness` below the surface.
-- Returns the number of wedges created (0 for degenerate triangles).
local function triangle(a: Vector3, b: Vector3, c: Vector3, thickness: number, parent: Instance, kind: string): number
	local ab, ac, bc = b - a, c - a, c - b
	local abd, acd, bcd = ab:Dot(ab), ac:Dot(ac), bc:Dot(bc)
	-- make bc the longest edge
	if abd > acd and abd > bcd then
		c, a = a, c
	elseif acd > bcd and acd > abd then
		a, b = b, a
	end
	ab, ac, bc = b - a, c - a, c - b
	local cross = ac:Cross(ab)
	if cross.Magnitude < 1e-6 then
		return 0
	end
	local right = cross.Unit
	local up = bc:Cross(right).Unit
	local back = bc.Unit
	local height = math.abs(ab:Dot(up))
	if height < 1e-4 then
		return 0
	end
	-- slab below the surface whichever way the triangle is wound
	local down = if right.Y > 0 then -right else right
	local shift = down * (thickness / 2)

	local w1 = newWedge()
	w1.Size = Vector3.new(thickness, height, math.abs(ab:Dot(back)))
	w1.CFrame = CFrame.fromMatrix((a + b) / 2 + shift, right, up, back)
	w1:SetAttribute(PREFIX .. "Kind", kind)
	w1.Parent = parent

	local w2 = newWedge()
	w2.Size = Vector3.new(thickness, height, math.abs(ac:Dot(back)))
	w2.CFrame = CFrame.fromMatrix((a + c) / 2 + shift, -right, up, -back)
	w2:SetAttribute(PREFIX .. "Kind", kind)
	w2.Parent = parent
	return 2
end

CollisionBuilder.Triangle = triangle

local function rowPoint(row: { number }, c: number): Vector3
	local k = (c - 1) * 3
	return Vector3.new(row[k + 1], row[k + 2], row[k + 3])
end

local function quatCFrame(p: { number }, q: { number }): CFrame
	return CFrame.new(p[1], p[2], p[3], q[1], q[2], q[3], q[4])
end

local function newModel(name: string, parent: Instance, streamingMode: string?): Model
	local m = Instance.new("Model")
	m.Name = name
	if streamingMode then
		local ok = pcall(function()
			(m :: any).ModelStreamingMode = (Enum.ModelStreamingMode :: any)[streamingMode]
		end)
		if not ok then
			warn("[SnowyValley] could not set ModelStreamingMode", streamingMode)
		end
	end
	m.Parent = parent
	return m
end

local function maybeYield(counter: { n: number }, every: number)
	counter.n += 1
	if counter.n % every == 0 then
		task.wait()
	end
end

-- Build everything under `root` (a Folder named "Collision").
type BuildOptions = { yieldEvery: number? }

function CollisionBuilder.Build(data: any, root: Instance, options: BuildOptions?): BuildStats
	local opts: BuildOptions = options or {}
	local yieldEvery = opts.yieldEvery or 1500
	local counter = { n = 0 }
	local thickness = Config.Collision.SurfaceThickness
	local mode = Config.Collision.SurfaceStreamingMode
	local stats: BuildStats = { wedges = 0, boxes = 0, kickers = 0, models = 0 }

	-- route surfaces, chunked by accumulated row length
	local surfaces = Instance.new("Folder")
	surfaces.Name = "Surfaces"
	surfaces.Parent = root
	local chunkLen = Config.Collision.ChunkLength
	local chunk: Model? = nil
	local acc = 0
	local chunkIndex: { [string]: number } = {}
	for _, strip in data.strips do
		local rows = strip.rows
		local nPts = #rows[1] // 3
		local kinds: { string } = strip.kinds
		for r = 1, #rows - 1 do
			local A, B = rows[r], rows[r + 1]
			local step = (rowPoint(A, 1) - rowPoint(B, 1)).Magnitude
			if chunk == nil or acc >= chunkLen or chunk:GetAttribute(PREFIX .. "Route") ~= strip.route then
				chunkIndex[strip.route] = (chunkIndex[strip.route] or 0) + 1
				chunk = newModel(string.format("%s_%03d", strip.route, chunkIndex[strip.route]), surfaces, mode)
				local cm = chunk :: Model
				cm:SetAttribute(PREFIX .. "Route", strip.route)
				stats.models += 1
				acc = 0
			end
			acc += step
			local parent = chunk :: Model
			for c = 1, nPts - 1 do
				local a0, b0 = rowPoint(A, c), rowPoint(B, c)
				local b1, a1 = rowPoint(B, c + 1), rowPoint(A, c + 1)
				local kind = kinds[c] or "Piste"
				stats.wedges += triangle(a0, b0, b1, thickness, parent, kind)
				stats.wedges += triangle(a0, b1, a1, thickness, parent, kind)
				maybeYield(counter, yieldEvery)
			end
		end
	end

	-- walkable ground patches
	local patches = newModel("Patches", root, mode)
	stats.models += 1
	for _, patch in data.patches do
		local nx, ny = patch.nx, patch.ny
		local pts: { number } = patch.points
		local function P(i: number, j: number): Vector3
			local k = ((j * nx) + i) * 3
			return Vector3.new(pts[k + 1], pts[k + 2], pts[k + 3])
		end
		local folder = Instance.new("Folder")
		folder.Name = patch.name
		folder.Parent = patches
		for j = 0, ny - 2 do
			for i = 0, nx - 2 do
				if patch.mask[j * (nx - 1) + i + 1] == 1 then
					local p00, p10, p01, p11 = P(i, j), P(i + 1, j), P(i, j + 1), P(i + 1, j + 1)
					stats.wedges += triangle(p00, p10, p11, thickness, folder, "Ground")
					stats.wedges += triangle(p00, p11, p01, thickness, folder, "Ground")
					maybeYield(counter, yieldEvery)
				end
			end
		end
	end

	-- boxes: walls, parapets, cave, catch floors
	local boxesModel = newModel("Boxes", root, mode)
	stats.models += 1
	local catchModel = newModel("CatchFloors", root, "Persistent")
	stats.models += 1
	for _, b in data.boxes do
		local part = Instance.new("Part")
		part.Name = b.kind
		part.Anchored = true
		part.CastShadow = false
		part.Locked = true
		part.Size = Vector3.new(b.size[1], b.size[2], b.size[3])
		part.CFrame = quatCFrame(b.position, b.rotation)
		part.Transparency = if Config.Collision.Debug then 0.7 else 1
		part.Color = Color3.fromRGB(60, 170, 255)
		part.TopSurface = Enum.SurfaceType.Smooth
		part.BottomSurface = Enum.SurfaceType.Smooth
		part:SetAttribute(PREFIX .. "Kind", b.kind)
		if b.kind == "CatchFloor" then
			part.CanCollide = true
			part.CanTouch = true
			part.CanQuery = false
			part.Parent = catchModel
		else
			-- walls are not ground: by default raycasts (SlopeRaycaster) skip them
			part.CanCollide = true
			part.CanTouch = false
			part.CanQuery = Config.Collision.WallsQueryable or b.kind == "CaveCeiling"
			part.Parent = boxesModel
		end
		stats.boxes += 1
		maybeYield(counter, yieldEvery)
	end

	-- kickers: one wedge each, sloped face up the travel direction
	local kickModel = newModel("Kickers", root, mode)
	stats.models += 1
	for i, k in data.kickers do
		local w = newWedge()
		w.Name = string.format("Kicker_%02d", i)
		w.Size = Vector3.new(k.size[1], k.size[2], k.size[3])
		w.CFrame = quatCFrame(k.position, k.rotation)
		w:SetAttribute(PREFIX .. "Kind", "Kicker")
		w.Parent = kickModel
		stats.kickers += 1
	end
	return stats
end

return CollisionBuilder
]]></ProtectedString>
